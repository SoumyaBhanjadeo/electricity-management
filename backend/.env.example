# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:admin@localhost:5433/electricity_management
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20


# Security & Token Settings
SECRET_KEY=super_secure_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60

OUTPUT_DIR=outputs
LOG_FILE_PATH=outputs/daily_import_audit.log